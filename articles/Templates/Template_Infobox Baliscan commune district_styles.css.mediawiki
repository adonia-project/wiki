.ib-french-constituency {
	border-collapse: collapse;
}

/* TODO split definitions to appropriate class names when live from HTML element */
.ib-french-constituency td,
.ib-french-constituency th {
	border: 1px solid #a2a9b1;
}

.ib-french-constituency .infobox-subheader {
	background: #ADDFAD;
	padding-left: 5px;
	padding-top: 5px;
}

.ib-french-constituency-member {
	border-left: 0.5em solid transparent;
	padding-left: 0.2em;
	margin: 0.2em;
}