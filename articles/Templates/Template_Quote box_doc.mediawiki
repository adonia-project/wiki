 |author = [[William Shakespeare]]
 |source = ''[[Julius Caesar (play)|Julius Caesar]]'', Act III, Scene I.
}}
{{Lorem ipsum}}</nowiki>}}{{-}}

'''Floating right:'''

{{demo|<nowiki>{{Quote box
 |quote  = Cry "Havoc", and let slip the dogs of war.
 |author = [[William Shakespeare]]
 |source = ''[[Julius Caesar (play)|Julius Caesar]]'', Act III, Scene I.
 |width  = 50%
 |align  = right
}}
{{Lorem ipsum}}</nowiki>}}{{-}}

'''Floating left:'''

{{demo|<nowiki>{{Quote box
 |quote  = Cry "Havoc", and let slip the dogs of war.
 |author = [[William Shakespeare]]
 |source = ''[[Julius Caesar (play)|Julius Caesar]]'', Act III, Scene I.
 |width  = 50%
 |align  = left
}}
{{Lorem ipsum}}</nowiki>}}{{-}}

'''Centered, not floating:'''

{{demo|<nowiki>{{Quote box
