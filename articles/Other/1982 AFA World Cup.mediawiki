|time = 20:00
|team1 = {{flag|Asikyira}}
|score = 1–0
|team2 = {{flag|Sanrobonia}}
|goals1 = [[Youssef Al-Hassan|Al-Hassan]] {{goal|67}}
|goals2 = 
