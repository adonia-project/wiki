|-
| water || ''tubig'' || ''tubig'' || ''tubig'' || *tubig
|-
| eat || ''kaon'' || ''kaon'' || ''kaon'' || *kaʔun
|-
| house || ''balay'' || ''balay'' || ''balay'' || *balay
|-
| ship || ''vaisel'' || ''banguka'' || ''sakayan'' || —
|-
| merchant || ''marsan'' || ''negosyante'' || ''tagbaligya'' || —
|-
| price || ''preyu'' || ''presyo'' || ''balanghay'' || —
|-
| warehouse || ''magatzem'' || ''bodega'' || ''katigulangan'' || —
