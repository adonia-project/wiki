# TALOD Wiki Sync Bot Configuration
# Copy this file to .env and fill in your credentials

# Miraheze wiki URL (without https://)
WIKI_URL=talod.miraheze.org

# Bot password credentials from Special:BotPasswords
WIKI_USERNAME=YourUsername@sync-bot
WIKI_PASSWORD=your-bot-password-here

# Path to the Balboa articles directory (relative to repo root)
BALBOA_DIR=articles/Countries/Balboa

# Sync state file (tracks last sync timestamps to detect changes)
SYNC_STATE_FILE=.talod-sync-state.json
